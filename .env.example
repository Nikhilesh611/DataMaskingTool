# ── Enterprise Data Masking Platform — Environment Configuration ───────────────

# ── 1. Relational Database (Docker PostgreSQL 15) ──────────────────────────────
# Strictly required. The platform runs against PostgreSQL with asyncpg.
DATABASE_URL=postgresql+asyncpg://masking_admin:masking_secure_password@localhost:5433/masking_db

# ── 2. Distributed Cache & Invalidation Mesh (Docker Redis 7) ─────────────────
# Used for L2 caching, distributed rate limiting, and multi-node cache invalidation.
REDIS_URL=redis://localhost:6379/0

# ── 3. Application Security & Cryptography ─────────────────────────────────────
# Master secret for tenant credential encryption at rest (AES-256-GCM) and sessions.
SECRET_KEY=enterprise-grade-32-byte-master-secret-key!

# Master administrative bearer token for root control plane bootstrap.
ADMIN_TOKEN=admin-master-secret-token

# ── 4. Logging & Telemetry ─────────────────────────────────────────────────────
# Python application log level: DEBUG | INFO | WARNING | ERROR
APP_LOG_LEVEL=INFO
