# ─── Required — server will not start without these ───────────────────────────

# Path to the directory that holds data files the API may serve.
# No trailing slash. Example: ./data or C:\data\patients  or  /srv/data/patients
DATA_DIR=

# Path to the masking policy YAML file.
# Example: ./policy.yaml or C:\config\policy.yaml  or  /etc/masking/policy.yaml
POLICY_PATH=

# Path to the append-only operator audit log.
# The file is created on first write if it does not exist.
# Example: ./audit.log or C:\logs\audit.log  or  /var/log/masking/audit.log
AUDIT_LOG_PATH=

# JSON object mapping bearer token strings to role names.
# Valid roles: analyst | operator | auditor
# Example: {"tok-analyst-001": "analyst", "tok-op-001": "operator", "tok-audit-001": "auditor"}
# Only used when AUTH_MODE=local (the default).
API_TOKENS={"tok-analyst-001": "analyst", "tok-op-001": "operator", "tok-audit-001": "auditor"}

# ─── Optional ─────────────────────────────────────────────────────────────────

# Python logging level for the application logger.  Default: INFO
# Valid values: DEBUG | INFO | WARNING | ERROR | CRITICAL
APP_LOG_LEVEL=INFO

# ─── Auth Mode ────────────────────────────────────────────────────────────────
# Controls how callers authenticate to the /mask endpoint.
#
# "local"          (default) — use API_TOKENS env var for token → role lookup.
#                  All existing behaviour is preserved.
#
# "enterprise_jwt" — validate JWTs issued by an enterprise IdP (Keycloak, Okta,
#                  Azure Entra, etc.).  Requires IDP_ISSUER, IDP_AUDIENCE,
#                  and IDP_MAPPINGS_PATH to be set.
#
# AUTH_MODE is DEPLOYMENT configuration — changing it requires a server restart.
# It is intentionally not hot-switchable.
AUTH_MODE=local

# ─── Enterprise JWT settings (required when AUTH_MODE=enterprise_jwt) ─────────

# The IdP issuer URL.  Used for two purposes:
#   1. JWT "iss" claim validation.
#   2. OIDC discovery base URL → {IDP_ISSUER}/.well-known/openid-configuration
#      (unless IDP_JWKS_URI is set explicitly — see below).
IDP_ISSUER=

# The expected "aud" claim value in JWTs issued for this service.
# Must match exactly what the IdP puts in the token.
IDP_AUDIENCE=

# Path to the group → internal role mapping JSON file.
# Format: [{"group": "finance-team", "internal_role": "auditor", "priority": 10}]
# Must exist before starting in enterprise_jwt mode (can be an empty list []).
IDP_MAPPINGS_PATH=

# ─── Enterprise JWT settings (optional) ───────────────────────────────────────

# Explicit JWKS URI.  When set, OIDC discovery is skipped entirely and JWKS
# keys are fetched from this URI directly.
#
# Why this exists: some environments cannot reach the OIDC discovery endpoint
# (air-gapped networks, custom PKI, development mocks).  Providing the JWKS
# URI explicitly lets the service work without discovery.
#
# If both IDP_ISSUER and IDP_JWKS_URI are set, IDP_JWKS_URI takes precedence
# for key fetching; IDP_ISSUER is still used for "iss" claim validation.
IDP_JWKS_URI=

# JWT claim key that contains the list of IdP groups.
# Default: "groups"
# Change this if your IdP uses a different claim name:
#   Keycloak:  groups
#   Cognito:   cognito:groups
#   Azure AD:  groups  (may be object IDs; map those in group_mappings.json)
IDP_GROUPS_CLAIM=groups

# JWKS cache TTL in seconds.  Default: 300.
# This is a reasonable operational default, not a hard security requirement.
# Shorten for high-security environments; increase for low-churn IdP setups.
IDP_JWKS_CACHE_TTL_SECONDS=300

# ─── Admin API (Phase 2) ──────────────────────────────────────────────────────
# Separate token for /admin/* endpoints.
# MUST be different from any API_TOKENS values.
# Never log or expose this value.
ADMIN_TOKEN=
